{
  "name": "pesat-board-server",
  "version": "1.0.0",
  "description": "Pesat Board backend - kanban ala Trello + WhatsApp 2-arah",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "seed": "tsx src/seed.ts",
    "seed:dist": "node dist/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0001_init.sql"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.0",
    "@prisma/client": "^6.19.3",
    "@whiskeysockets/baileys": "6.7.23",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "fastify-plugin": "^5.1.0",
    "nanoid": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
